generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
 id    BigInt     @id @default(autoincrement())
  name       String
  phone      String
  email      String
  status     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // User       User?    @relation(fields: [assignedTo], references: [id])
}

model User {
   id    BigInt     @id @default(autoincrement())
  fullName   String
  email      String   @unique
  phone      String
  password   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Lead       Lead[]
}

model contact_leads {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now())
  name       String?
  email      String?  @unique
  phone      String?
  message    String?
}
